# 한국투자증권(KIS) Open API 설정
KIS_IS_PAPER_TRADING=false

# 발급받은 AppKey 및 AppSecret
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here

# 1번 계좌 (앞 8자리 + 상품코드 2자리)
KIS_CANO=
KIS_ACNT_PRDT_CD=01

# 2번 계좌 (선택사항)
KIS_CANO_2=
KIS_ACNT_PRDT_CD_2=01

# 3번 계좌 (선택사항)
KIS_CANO_3=
KIS_ACNT_PRDT_CD_3=01

KIS_HTS_ID=
